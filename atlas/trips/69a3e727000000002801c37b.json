  "notes": [
    { "place": "susukino", "tone": "good", "text": "住薄野：札幌最热闹的地带但不拥挤，逛吃绝对便利。Sapporo Stream Hotel 12 月底参考价 1.3k。", "from": "post" },
    { "place": "sapporo", "tone": "info", "text": "逛：CA4LA、Kapital、札幌工厂、mont-bell；吃：Komeda、三郎海鲜居酒屋、Mermaid Coffee Roasters。", "from": "post" },
    { "place": "zenibako", "tone": "good", "text": "去小樽路上一定会路过，值得下车逛一圈，一半雪地一半海面，很治愈。", "from": "post" },
    { "place": "biei", "tone": "good", "text": "离旭川站约 30 分钟，小镇不大但很治愈，值得留两小时闲逛。", "from": "post" },
    { "place": "aoiike", "tone": "good", "text": "白金青池可以雪地徒步，约 30 分钟到白须瀑布；白金神社藏在瀑布旁边，一不留神就错过。", "from": "post" },
    { "place": "asahidake", "tone": "good", "text": "本次隆重推荐：大巴 1 小时往山里去，真有「雪国」的实感。", "from": "post" },
    { "place": "hotel-jrinn-asahikawa", "tone": "info", "text": "旭川站 JR INN，1 月初参考价 1.2k；市区餐厅不多，回来晚了可以去大型超市。", "from": "post" },
    { "place": "hachimanzaka", "tone": "meh", "text": "八幡坂和金森红砖仓库个人无感，但 Bay 区值得留一整天闲逛。", "from": "post" },
    { "place": "goryokaku", "tone": "good", "text": "函馆最喜欢的五角星公园，大树疯长，冬天也别有味道。", "from": "post" },
    { "place": "asahidake", "tone": "info", "text": "从旭川坐大巴约 1 小时进山。", "from": "post" },
